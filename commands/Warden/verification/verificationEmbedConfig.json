{
    "responseDefaults": {
        "timestamp": true,
        "footer": {
            "enabled": true,
            "text": "Warden Verification"
        },
        "colors": {
            "success": "#57F287",
            "error": "#E74C3C",
            "warning": "#F1C40F",
            "info": "#ff7100",
            "neutral": "#1f1f1f"
        }
    },
    "imageGeneration": {
        "gallery": {
            "defaultSize": 6,
            "fetchTimeoutMs": 10000,
            "composite": {
                "gridColumns": 3,
                "tileSize": 320,
                "labelPadding": 16,
                "labelSize": 72
            }
        },
        "prompt": {
            "width": 960,
            "minHeight": 320,
            "padding": 54,
            "fontSize": 54,
            "lineHeight": 74,
            "curveNoiseCount": 170,
            "pixelNoiseCount": 3200,
            "decoyGlyphs": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789?/#%&",
            "decoyGlyphCount": 160,
            "occlusionLineCount": 26,
            "maxCharacterRotation": 0.18,
            "characterJitter": 7,
            "palettes": [
                {
                    "background": ["#07111f", "#14213d", "#0b1020"],
                    "curve": ["#76d7ff", "#f5b7ff"],
                    "glyph": ["#d9f3ff", "#ffd9fb"],
                    "stroke": "rgba(118, 215, 255, 0.70)"
                },
                {
                    "background": ["#1c0b2b", "#3d145c", "#10091f"],
                    "curve": ["#ff9cf5", "#8ad8ff"],
                    "glyph": ["#ffe2fb", "#d8f4ff"],
                    "stroke": "rgba(255, 156, 245, 0.70)"
                },
                {
                    "background": ["#06261d", "#115740", "#071611"],
                    "curve": ["#8dffcc", "#ffe08a"],
                    "glyph": ["#dcfff0", "#fff2cc"],
                    "stroke": "rgba(141, 255, 204, 0.70)"
                },
                {
                    "background": ["#2b1608", "#5a3112", "#120904"],
                    "curve": ["#ffcf8a", "#8ac7ff"],
                    "glyph": ["#fff1d8", "#d8ecff"],
                    "stroke": "rgba(255, 207, 138, 0.70)"
                },
                {
                    "background": ["#25110f", "#5b1f2d", "#120708"],
                    "curve": ["#ff8aa8", "#ffd36e"],
                    "glyph": ["#ffe0e7", "#fff0c5"],
                    "stroke": "rgba(255, 138, 168, 0.70)"
                }
            ]
        }
    },
    "adminResponseTemplates": {
        "genericError": {
            "title": "Verification Error",
            "description": "{message}",
            "color": "error"
        },
        "settingUpdated": {
            "title": "Verification {label} Updated",
            "description": "{message}",
            "color": "success"
        },
        "settingStatus": {
            "title": "Verification {label} Status",
            "description": "{message}",
            "color": "info"
        },
        "configurationList": {
            "title": "Verification {label} Configuration",
            "description": "{message}",
            "color": "info"
        },
        "actionCompleted": {
            "title": "Verification {label}",
            "description": "{message}",
            "color": "success"
        },
        "summary": {
            "title": "Verification {label}",
            "description": "{message}\n\n{summary}",
            "color": "{tone}"
        }
    },
    "welcomeEmbed": {
        "title": "Welcome to the Anti-Xeno Initiative",
        "description": "We are an Elite: Dangerous community centered on Thargoid Combat (Anti-Xeno) and defending humanity.",
        "color": "#ff7100",
        "thumbnail": {
            "enabled": true,
            "url": "https://antixenoinitiative.com/wp-content/uploads/2024/09/cropped-AXI_Logo_New2.png"
        },
        "icon": {
            "enabled": false,
            "url": "https://antixenoinitiative.com/wp-content/uploads/2024/09/cropped-AXI_Logo_New2.png"
        },
        "fields": [
            {
                "name": "Verification",
                "value": "Please verify to access the server. Click the Verify button.",
                "inline": false
            }
        ]
    },
    "challengeEmbed": {
        "title": "Verification Challenge",
        "description": "Answer this challenge to verify: {challenge}",
        "color": "neutral"
    },
    "successEmbed": {
        "title": "Verification Complete",
        "description": "You have been verified successfully.",
        "color": "success"
    },
    "failureEmbed": {
        "title": "Verification Failed",
        "description": "That answer was incorrect. Please try again in {cooldownSeconds} seconds.",
        "color": "error"
    },
    "inProgressEmbed": {
        "title": "Verification in Progress",
        "description": "You already have a verification challenge in progress. Please answer your current challenge or retry after it expires {retryTime}.",
        "color": "neutral"
    },
    "expiredChallengeEmbed": {
        "title": "Verification Challenge Expired",
        "description": "Your verification challenge has expired. Please start verification again.",
        "color": "neutral"
    },
    "verificationHelpEmbed": {
        "title": "Verification Help",
        "description": "Click the **Verify** button to start the verification process.\nFollow the prompts and read carefully.\nUse the **Give Answer** button and fill in the modal.",
        "color": "info",
        "fields": [
            {
                "name": "Contact",
                "value": "If you encounter problems, please direct message a staff member <@380248192534577152>, <@380248896385056769> or <@380249268818018304> from the member list.\n\nOr contact us through our [website](<https://antixenoinitiative.com/contact/>).",
                "inline": false
            }
        ],
        "thumbnail": {
            "enabled": true,
            "url": "https://antixenoinitiative.com/wp-content/uploads/2024/09/cropped-AXI_Logo_New2.png"
        }
    },
    "autoKickEmbed": {
        "title": "Verification Time Limit",
        "description": "You were automaticly removed from **{serverName}** after not completing verification.",
        "color": "info",
        "fields": [
            {
                "name": "Why?",
                "value": "To protect our server, new members need to verify within {autokickTimer} or they will be removed.",
                "inline": false
            },
            {
                "name": "Can I try again?",
                "value": "Yes! Rejoin the server and complete verification.\n\n<https://discord.com/invite/antixenoinitiative>",
                "inline": false
            }
        ],
        "thumbnail": {
            "enabled": true,
            "url": "https://antixenoinitiative.com/wp-content/uploads/2024/09/cropped-AXI_Logo_New2.png"
        }
    },
    "autoKickWelcomeField": {
        "title": "Time limit",
        "value": "Please complete verification within {autokickTimer}. If you are still unverified when that timer expires, you will be removed from the server.",
        "inline": false
    }
}
